location            = "westus2"

# NEW dev RG (no conflict)
resource_group_name = "cloud-guard-ai-rg-dev"

# Storage account must be globally unique, lowercase, 3-24 chars
# Change this if it says "already taken"
storage_account_name = "guardstoragedev01"

# NEW dev Function App name (must be globally unique in Azure)
# If it errors, change the suffix
function_app_name = "cloudguard-backend-dev"

# Service Bus namespace must be globally unique
servicebus_namespace_name = "analyze-jobs-dev"

# Queue can be same name
analyze_queue_name = "analyze-job"

# CORS: put your SWA URL here once you know it.
# For now, allow localhost and your SWA later.
cors_allowed_origins = "http://localhost:5173"

# Flex consumption. If it errors in your subscription, change to "Y1".
function_plan_sku = "FC1"

# Don’t create SWA via Terraform yet (optional)
create_static_web_app = false
static_web_app_name   = "CloudguardApp-dev"
